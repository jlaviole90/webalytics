# Copy to terraform.tfvars and edit.

# Required: where cloud-init pulls the code from on boot.
git_repo_url = "https://github.com/YOUR_ORG/webalytics.git"
git_branch   = "main"

# Optional: your own hostname. Leave empty and Terraform will default
# to <static_ip>.nip.io, which resolves back to the box automatically
# and gets a real Let's Encrypt cert (no DNS setup required from you).
# Swap to your real domain later by setting this + pointing an A record
# at the public_ip output.
domain = ""

# Recommended: email Let's Encrypt will send cert expiry notices to.
# acme_email = "you@example.com"

# Optional: tighten SSH access to your office / home IP.
# allow_ssh_from_cidr = "203.0.113.42/32"

# Optional: paste the public key you want root access with. Leave unset to
# have Terraform generate a fresh ed25519 pair and drop it in keys/.
# ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
