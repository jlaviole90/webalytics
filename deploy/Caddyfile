# Caddyfile for production.
#
# Env vars (set by docker-compose.prod.yml from /opt/webalytics/.env.prod):
#   DOMAIN      - required. Either your own hostname or <ip>.nip.io.
#                 Triggers automatic HTTPS via Let's Encrypt.
#   ACME_EMAIL  - optional. Tells LE where to send expiry warnings.
#
# This box is API-only. Routes:
#   /collect, /collect/**          -> Go api (tracker ingest)
#   /v1/**                         -> Go api (authenticated query API)
#   /public/v1/**                  -> Go api (browser-safe public embed API)
#   /healthz                       -> Go api (health)
#   everything else                -> 404 JSON (no UI hosted here)
#
# Postgres/ClickHouse/Redis live on the internal docker network only.

# No global options block: Caddy registers an anonymous Let's Encrypt
# account. This means LE can't email you expiry warnings, but Caddy
# renews certs automatically (60 days before expiry) so it rarely
# matters. If you want email notifications, the ACME_EMAIL plumbing is
# still in place; add a global block here referencing {$ACME_EMAIL}
# once you've confirmed ACME_EMAIL is set to a real address in .env.prod
# (Caddy crashes on an empty `email` directive).

{$DOMAIN} {
	encode gzip zstd

	# Minimal security headers.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options        "SAMEORIGIN"
		Referrer-Policy        "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Ingest hot path + authenticated /v1 API -> Go service.
	# `handle` blocks are mutually exclusive; whichever matches first
	# runs, and its contents are self-contained. Keeps the fallback
	# from swallowing /healthz etc.
	@api path /collect /collect/* /v1/* /public/v1/* /healthz
	handle @api {
		reverse_proxy api:8080
	}

	# Anything else: tiny advertising JSON so it's obvious what this is.
	# Returning a bare 404 on / would look broken; this makes intent
	# clear without exposing anything sensitive.
	handle {
		header Content-Type application/json
		respond `{"service":"webalytics","api":"/v1","ingest":"/collect","docs":"https://github.com/YOUR_ORG/webalytics"}` 404
	}
}
