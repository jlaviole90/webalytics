# Caddyfile for production.
#
# Env vars (set by docker-compose.prod.yml from /opt/webalytics/.env.prod):
#   DOMAIN      - required. Either your own hostname or <ip>.nip.io.
#                 Triggers automatic HTTPS via Let's Encrypt.
#   ACME_EMAIL  - optional. Tells LE where to send expiry warnings.
#
# Routes:
#   /collect, /collect/**          -> Go api (tracker ingest)
#   /v1/**                         -> Go api (authenticated query API)
#   /healthz                       -> Go api (health)
#   everything else                -> Next.js dashboard
#
# Postgres/ClickHouse/Redis live on the internal docker network only and
# are never exposed by Caddy.

# Global options: ACME account email for Let's Encrypt.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	# Minimal security headers for a single-origin dashboard.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options        "SAMEORIGIN"
		Referrer-Policy        "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Ingest hot path + authenticated /v1 API -> Go service.
	@api {
		path /collect /collect/* /v1/* /healthz
	}
	reverse_proxy @api api:8080

	# Everything else -> dashboard.
	reverse_proxy dashboard-next:3001
}
