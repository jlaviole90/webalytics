{
  "name": "@webalytics/tracker-angular",
  "version": "0.1.0",
  "description": "Angular bindings for @webalytics/tracker: injectable service + auto page-view tracking on Router navigation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/router": ">=17",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "dependencies": {
    "@webalytics/tracker": "0.1.0"
  },
  "devDependencies": {
    "@angular/common": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "zone.js": "^0.14.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
