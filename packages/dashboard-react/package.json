{
  "name": "@jlaviole90/dashboard-react",
  "version": "0.1.5",
  "description": "Server-rendered React components for displaying Webalytics data, Vercel-style.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlaviole90/webalytics.git",
    "directory": "packages/dashboard-react"
  },
  "homepage": "https://github.com/jlaviole90/webalytics/tree/main/packages/dashboard-react#readme"
}
