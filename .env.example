# Webalytics service configuration
# Copy to .env and adjust; docker-compose reads this file automatically.

# -------- HTTP --------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=30s

# -------- Logging --------
LOG_LEVEL=info        # debug | info | warn | error
LOG_FORMAT=json       # json | text

# -------- Postgres (control plane) --------
# Production: two separate DSNs, one for the app role (with RLS enforced)
# and one for the ingest role (BYPASSRLS, read-only via ingest_site_lookup).
POSTGRES_APP_DSN=postgres://webalytics_app:changeme@postgres:5432/webalytics?sslmode=disable
POSTGRES_INGEST_DSN=postgres://webalytics_ingest:changeme@postgres:5432/webalytics?sslmode=disable
POSTGRES_MAX_CONNS=20

# -------- ClickHouse (event plane) --------
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=webalytics
CLICKHOUSE_USER=webalytics
CLICKHOUSE_PASSWORD=changeme

# -------- Redis (rate limit, realtime counter, cache) --------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# -------- Ingest --------
# HMAC salt for daily session IDs. Rotated automatically every 24h at UTC midnight;
# this value is the base seed used alongside the rotating salt.
SESSION_SALT_BASE=please-change-me-to-32+-random-bytes

# GeoIP DB path inside the container. Mount a MaxMind GeoLite2-City.mmdb here.
GEOIP_DB_PATH=/var/lib/webalytics/GeoLite2-City.mmdb

# Batcher
INGEST_BATCH_MAX_ROWS=500
INGEST_BATCH_FLUSH_MS=250

# Per-site rate limits (requests/sec/IP)
INGEST_RATE_PER_IP=50
INGEST_RATE_PER_SITE=500

# -------- Postgres seed credentials used only by docker-compose's postgres init script --------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webalytics
