{
  "name": "webalytics-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Root workspace for the Webalytics NPM packages. The Go backend lives at the repo root; JS lives under packages/ and apps/.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "test/browser"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "size": "npm run size -w @webalytics/tracker",
    "dev:demo": "npm run dev -w webalytics-demo-next"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
